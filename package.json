{
  "name": "@slicr97/simple-rules",
  "version": "1.1.0",
  "description": "Simple input validation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepublish": "rm -rf dist && npx tsc",
    "build": "rm -rf dist && npx tsc",
    "test": "mocha",
    "cover": "nyc mocha",
    "lint": "eslint . --ext .ts",
    "prettier-format": "prettier --config .prettierrc '{src,test}/**/*.ts' --write",
    "prepare": "husky install",
    "pre-commit": "lint-staged"
  },
  "repository": "git@github.com:SlicR97/simple-rules.git",
  "author": "Nico Loos",
  "license": "MIT",
  "private": false,
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/chai": "^4.3.7",
    "@types/mocha": "^10.0.2",
    "@types/node": "^20.8.4",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "chai": "^4.3.10",
    "eslint": "^8.51.0",
    "husky": "^8.0.0",
    "lint-staged": "^14.0.1",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "prettier": "^3.0.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "lint-staged": {
    "**/*.ts": [
      "yarn lint",
      "yarn prettier-format"
    ]
  },
  "nyc": {
    "extends": "@istanbuljs/nyc-config-typescript",
    "check-coverage": true,
    "all": true,
    "include": [
      "src/**/!(*.test.*).ts"
    ],
    "reporter": [
      "html",
      "text"
    ],
    "report-dir": "coverage",
    "branches": 95,
    "lines": 95,
    "functions": 95,
    "statements": 95
  }
}
